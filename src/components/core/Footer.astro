---
import { profile } from "../../data/profile";
const currentYear = new Date().getFullYear();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="border-t border-border/40 bg-[hsl(var(--bg-studio))] py-12 text-sm text-muted-foreground">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: Bio / Positioning -->
      <div class="md:col-span-2 space-y-3">
        <span class="text-base font-bold text-foreground tracking-tight">
          {profile.name}
        </span>
        <p class="text-xs text-muted-foreground max-w-md leading-relaxed">
          {profile.tagline}
        </p>
        <p class="text-xs text-muted-foreground font-mono-tech">
          Based in {profile.location} · {profile.education.institution}
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-foreground">
          Navigation
        </span>
        <ul class="space-y-1.5 text-xs">
          <li><a href={`${basePath}/`} class="hover:text-primary transition-colors">Featured Work</a></li>
          <li><a href={`${basePath}/about`} class="hover:text-primary transition-colors">About & Pipeline</a></li>
          <li><a href={`${basePath}/contact`} class="hover:text-primary transition-colors">Contact / Inquiries</a></li>
          {profile.features.resources && (
            <li><a href={`${basePath}/resources`} class="hover:text-primary transition-colors">Free Resources & Articles</a></li>
          )}
        </ul>
      </div>

      <!-- Col 3: Verified Connect Links -->
      <div class="space-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-foreground">
          Connect
        </span>
        <ul class="space-y-1.5 text-xs">
          <li>
            <a href={`mailto:${profile.email}`} class="hover:text-primary transition-colors">
              {profile.email}
            </a>
          </li>
          <li>
            <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              GitHub: AK050744 ↗
            </a>
          </li>
          {profile.linkedin && !profile.linkedin.includes("TODO") && (
            <li>
              <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
                LinkedIn ↗
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-border/20 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <p>
        © {currentYear} {profile.name}. All 3D assets and renders reserved.
      </p>
      <div class="flex items-center gap-4">
        <span class="font-mono-tech text-[11px] text-muted-foreground/80">
          Static-first · WCAG 2.2 AA · 0 Third-Party Cookies
        </span>
        <a href="#top" class="text-primary hover:underline font-mono-tech" aria-label="Back to top of page">
          ↑ Top
        </a>
      </div>
    </div>
  </div>
</footer>
