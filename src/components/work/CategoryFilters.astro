---
interface Props {
  activeCategory?: string;
  counts: Record<string, number>;
}

const { activeCategory = "all", counts } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const filters = [
  { id: "all", label: "All Work", count: counts.all || 0 },
  { id: "character", label: "Character Design", count: counts.character || 0 },
  { id: "environment", label: "Environment Art", count: counts.environment || 0 },
  { id: "product", label: "Product Visualization", count: counts.product || 0 },
  { id: "motion", label: "Motion Graphics", count: counts.motion || 0 },
  { id: "personal", label: "Personal Projects", count: counts.personal || 0 },
];
---

<nav aria-label="Work category filters" class="w-full">
  <!-- Live Region Announcement for Screen Readers (WCAG 4.1.3) -->
  <div id="filter-status" class="sr-only" aria-live="polite" role="status">
    Showing {counts[activeCategory] || counts.all} projects for category {activeCategory}.
  </div>

  <div class="flex flex-wrap items-center gap-2 pb-2">
    {filters.map((filter) => {
      const isSelected = activeCategory === filter.id;
      const targetUrl = filter.id === "all" ? `${basePath}/#work-grid` : `${basePath}/?category=${filter.id}#work-grid`;

      return (
        <a
          href={targetUrl}
          class={`inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-mono-tech transition-all focus-visible:ring-2 focus-visible:ring-ring ${
            isSelected
              ? "bg-primary text-black font-bold shadow-md shadow-primary/20"
              : "bg-[hsl(var(--bg-surface))] text-muted-foreground hover:bg-white/10 hover:text-foreground border border-border/40"
          }`}
          aria-pressed={isSelected ? "true" : "false"}
          data-category={filter.id}
        >
          <span>{filter.label}</span>
          <span class={`rounded-full px-1.5 py-0.2 text-[10px] ${
            isSelected ? "bg-black/20 text-black" : "bg-white/10 text-muted-foreground"
          }`}>
            {filter.count}
          </span>
        </a>
      );
    })}
  </div>
</nav>
