---
import ProjectCard from "./ProjectCard.astro";
import CategoryFilters from "./CategoryFilters.astro";
import { projects } from "../../data/projects";

interface Props {
  selectedCategory?: string;
}

const { selectedCategory = "all" } = Astro.props;

// Calculate counts per category
const counts: Record<string, number> = {
  all: projects.length,
  character: projects.filter((p) => p.category === "character").length,
  environment: projects.filter((p) => p.category === "environment").length,
  product: projects.filter((p) => p.category === "product").length,
  motion: projects.filter((p) => p.category === "motion").length,
  personal: projects.filter((p) => p.category === "personal").length,
};

const filteredProjects =
  !selectedCategory || selectedCategory === "all"
    ? projects
    : projects.filter((p) => p.category === selectedCategory);
---

<section id="work-grid" class="scroll-mt-20 py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 border-b border-border/30 pb-6">
    <div>
      <div class="inline-flex items-center gap-2 text-xs font-mono-tech text-primary uppercase tracking-wider mb-2">
        <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        Portfolio Portfolio
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-foreground tracking-tight">
        Featured 3D & Animation Projects
      </h2>
    </div>

    <!-- Live Project Count Badge -->
    <div class="font-mono-tech text-xs text-muted-foreground">
      Displaying <span class="text-primary font-bold">{filteredProjects.length}</span> of {projects.length} Works
    </div>
  </div>

  <!-- Category Filter Controls -->
  <div class="mb-10">
    <CategoryFilters activeCategory={selectedCategory} counts={counts} />
  </div>

  <!-- Project Grid Layout -->
  {filteredProjects.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {filteredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  ) : (
    <div class="rounded-xl border border-dashed border-border/60 p-12 text-center bg-[hsl(var(--bg-surface))]">
      <p class="text-muted-foreground text-sm font-mono-tech">
        No projects found for category "{selectedCategory}".
      </p>
      <a href="#work-grid" class="mt-4 inline-block text-xs text-primary hover:underline font-mono-tech">
        View all projects →
      </a>
    </div>
  )}
</section>

