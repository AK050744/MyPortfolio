---
import type { Project } from "../../data/schema";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

interface Props {
  project: Project;
}

const { project } = Astro.props;

const categoryLabels: Record<string, string> = {
  character: "Character Design",
  environment: "Environment Art",
  product: "Product Visualization",
  motion: "Motion Graphics",
  personal: "Personal Exploration",
};
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-border/50 bg-[hsl(var(--bg-surface))] transition-all duration-300 hover:border-primary/50 hover:shadow-2xl hover:shadow-primary/5">
  <!-- Card Image / Media Preview Container -->
  <div class="relative aspect-video w-full overflow-hidden bg-black/40">
    <!-- Static Hero Render Thumbnail (Always shown) -->
    <img
      src={project.hero.image.src}
      alt={project.hero.image.alt}
      width={project.hero.image.width}
      height={project.hero.image.height}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />

    <!-- Category Badge & Year Badge -->
    <div class="absolute top-3 left-3 z-10 flex items-center gap-2">
      <span class="rounded bg-black/75 px-2 py-0.5 text-[11px] font-mono-tech text-primary border border-primary/30 backdrop-blur-sm">
        {categoryLabels[project.category] || project.category}
      </span>
      <span class="rounded bg-black/75 px-2 py-0.5 text-[11px] font-mono-tech text-foreground/80 backdrop-blur-sm">
        {project.year}
      </span>
    </div>

    <!-- 3D Model Available Indicator -->
    {project.model && (
      <div class="absolute top-3 right-3 z-10">
        <span class="inline-flex items-center gap-1 rounded bg-primary px-2 py-0.5 text-[10px] font-bold text-black font-mono-tech">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
          </svg>
          3D
        </span>
      </div>
    )}
  </div>

  <!-- Card Content Details -->
  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors">
        <a
          href={`${basePath}/work/${project.slug}`}
          class="focus:outline-none focus-visible:underline after:absolute after:inset-0"
        >
          {project.title}
        </a>
      </h3>

      <p class="mt-2 text-xs text-muted-foreground line-clamp-2 leading-relaxed">
        {project.summary}
      </p>
    </div>

    <!-- Roles & Software Pills -->
    <div class="mt-4 pt-3 border-t border-border/30 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1">
        {project.roles.slice(0, 3).map((role) => (
          <span class="rounded bg-white/5 px-1.5 py-0.5 text-[10px] font-mono-tech text-foreground/70">
            {role}
          </span>
        ))}
      </div>
      <span class="text-xs font-semibold text-primary inline-flex items-center gap-1">
        Details →
      </span>
    </div>
  </div>
</article>
