---
import BaseLayout from "../layouts/BaseLayout.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="404 - Page Not Found · Ansh Kumar Singh"
  description="The requested 3D project or page could not be located."
>
  <div class="py-24 px-4 text-center max-w-xl mx-auto flex flex-col items-center justify-center flex-1">
    <span class="inline-block text-5xl font-mono-tech font-extrabold text-primary mb-4">
      404
    </span>
    <h1 class="text-2xl sm:text-3xl font-bold text-foreground mb-3">
      Render Asset Not Found
    </h1>
    <p class="text-sm text-muted-foreground mb-8 leading-relaxed font-mono-tech">
      The project slug or page you requested does not exist or has been relocated within the portfolio archive.
    </p>
    <a
      href={`${basePath}/`}
      class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-xs font-semibold font-mono-tech text-black hover:bg-amber-400 transition-colors focus-visible:ring-2 focus-visible:ring-ring"
    >
      ← Return to Featured Work
    </a>
  </div>
</BaseLayout>

