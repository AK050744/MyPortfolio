---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { resources } from "../data/resources";

if (!profile.features.resources) {
  return Astro.redirect("/404");
}
---

<BaseLayout
  title={`Resources & Technical Articles · ${profile.name}`}
  description={`Free 3D calibration assets, procedural shader node graphs, and technical art tutorials authored by Ansh Kumar Singh.`}
>
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <header class="mb-12 border-b border-border/40 pb-8">
      <div class="inline-flex items-center gap-2 text-xs font-mono-tech text-primary uppercase tracking-wider mb-2">
        <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        Community & Tooling
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight">
        Resources, Models & Tutorials
      </h1>
      <p class="text-muted-foreground text-sm mt-3 max-w-2xl leading-relaxed">
        Free 3D assets, procedural node groups, and pipeline notes. All 3D models and downloadable items are authored by Ansh Kumar Singh with explicit distribution licenses.
      </p>
    </header>

    <div class="space-y-6">
      {resources.map((item) => (
        <article class="rounded-xl border border-border/50 bg-[hsl(var(--bg-surface))] p-6 sm:p-8 hover:border-primary/40 transition-colors">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
            <span class="rounded bg-primary/10 border border-primary/30 px-2.5 py-0.5 text-xs font-mono-tech text-primary uppercase">
              {item.type}
            </span>
            <span class="text-xs font-mono-tech text-muted-foreground">
              {item.date}
            </span>
          </div>

          <h2 class="text-xl font-bold text-foreground mb-2">
            {item.title}
          </h2>

          <p class="text-xs sm:text-sm text-foreground/80 leading-relaxed mb-6">
            {item.description}
          </p>

          <div class="pt-4 border-t border-border/30 flex flex-wrap items-center justify-between gap-4 text-xs font-mono-tech">
            <div class="space-y-0.5">
              <span class="text-muted-foreground block text-[11px]">License & Authorship:</span>
              <span class="text-foreground/90 font-semibold">{item.license}</span>
            </div>

            <div class="flex items-center gap-3">
              {item.downloadUrl && (
                <a
                  href={item.downloadUrl}
                  download
                  class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3.5 py-1.5 text-xs font-semibold text-black hover:bg-amber-400 transition-colors focus-visible:ring-2 focus-visible:ring-ring"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  <span>Download {item.format || "File"} ({item.fileSize})</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
