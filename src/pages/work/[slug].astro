---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, getProjectBySlug } from "../../data/projects";
import { ModelViewer3D } from "../../components/viewer3d/ModelViewer3D";
import { ImageLightbox } from "../../components/project/ImageLightbox";
import { VideoFacade } from "../../components/project/VideoFacade";
import WipGalleryTabs from "../../components/project/WipGalleryTabs.astro";

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug as string);

if (!project) {
  return Astro.redirect("/404");
}

const currentIndex = projects.findIndex((p) => p.slug === slug);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : null;
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : null;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`${project.title} · ${project.year} · Ansh Kumar Singh`}
  description={project.summary}
  image={project.hero.image.src}
>
  <article class="py-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-mono-tech text-muted-foreground">
      <a href={`${basePath}/`} class="hover:text-primary transition-colors">
        ← Back to All Work
      </a>
      <span>/</span>
      <span class="text-primary uppercase">{project.category}</span>
    </nav>

    <!-- Project Header -->
    <header class="mb-12 border-b border-border/40 pb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="rounded bg-primary px-2.5 py-1 text-xs font-bold font-mono-tech text-black">
          {project.year}
        </span>
        <span class="rounded border border-border/60 bg-white/5 px-2.5 py-1 text-xs font-mono-tech text-muted-foreground">
          {project.client ? `Client: ${project.client}` : "Personal Portfolio Project"}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight mb-6">
        {project.title}
      </h1>

      <!-- Meta Grid: Roles & Confirmed Software -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-border/20 text-xs">
        <div>
          <span class="block text-muted-foreground uppercase font-mono-tech mb-2 font-semibold">
            Roles & Responsibilities
          </span>
          <div class="flex flex-wrap gap-1.5">
            {project.roles.map((role) => (
              <span class="rounded bg-white/5 px-2.5 py-1 font-mono-tech text-foreground/90 border border-white/10">
                {role}
              </span>
            ))}
          </div>
        </div>

        <div>
          <span class="block text-muted-foreground uppercase font-mono-tech mb-2 font-semibold">
            Software & Pipeline Tools
          </span>
          <div class="flex flex-wrap gap-2">
            {project.software.map((sw) => (
              <span class="inline-flex items-center gap-1.5 rounded bg-primary/10 px-2.5 py-1 font-mono-tech text-primary border border-primary/30">
                <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true" />
                <span>{sw.name}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Section 1: Hero Render or Interactive 3D Viewer -->
    <section class="mb-16" aria-label="Hero Showcase">
      {project.model ? (
        <div>
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-mono-tech text-muted-foreground uppercase tracking-wider font-semibold">
              Interactive 3D Viewport (Opt-in)
            </h2>
            <span class="text-xs font-mono-tech text-primary">
              Three.js · Draco GLB
            </span>
          </div>
          <!-- React Island: Three.js 3D Viewer -->
          <ModelViewer3D client:visible model={project.model} projectTitle={project.title} />
        </div>
      ) : (
        <div class="aspect-video w-full overflow-hidden rounded-xl border border-border/50 bg-black/40">
          <img
            src={project.hero.image.src}
            alt={project.hero.image.alt}
            width={project.hero.image.width}
            height={project.hero.image.height}
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>
      )}
    </section>

    <!-- Section 2: Project Overview Description -->
    <section class="mb-16 max-w-3xl" aria-labelledby="overview-title">
      <h2 id="overview-title" class="text-xl font-bold text-foreground mb-4">
        Project Overview
      </h2>
      <p class="text-base text-foreground/80 leading-relaxed font-sans">
        {project.summary}
      </p>
    </section>

    <!-- Section 3: Concept / Reference (if available) -->
    {project.concept && project.concept.length > 0 && (
      <section class="mb-16" aria-labelledby="concept-title">
        <h2 id="concept-title" class="text-xl font-bold text-foreground mb-4 flex items-center gap-2">
          <span>Concept & Mood Board Reference</span>
          <span class="text-xs font-mono-tech text-muted-foreground font-normal">({project.concept.length} items)</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {project.concept.map((c) => (
            <figure class="overflow-hidden rounded-lg border border-border/40 bg-black/40">
              <img src={c.src} alt={c.alt} width={c.width} height={c.height} loading="lazy" class="w-full object-cover" />
              {c.caption && (
                <figcaption class="p-3 bg-[hsl(var(--bg-surface))] text-xs text-muted-foreground">
                  {c.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Section 4: Work in Progress (WIP) Passes (if available) -->
    {project.wip && (
      <section class="mb-16" aria-labelledby="wip-title">
        <h2 id="wip-title" class="text-xl font-bold text-foreground mb-4">
          Work in Progress & Topology Passes
        </h2>
        <WipGalleryTabs
          wireframe={project.wip.wireframe}
          clay={project.wip.clay}
          lighting={project.wip.lighting}
        />
      </section>
    )}

    <!-- Section 5: Final Renders Gallery + Lightbox -->
    <section class="mb-16" aria-labelledby="finals-title">
      <div class="flex items-center justify-between mb-4">
        <h2 id="finals-title" class="text-xl font-bold text-foreground">
          Final Renders & Angles
        </h2>
        <span class="text-xs font-mono-tech text-muted-foreground">
          Click any render to open keyboard-navigable Lightbox
        </span>
      </div>
      <!-- React Island: ImageLightbox -->
      <ImageLightbox client:idle images={project.finals} />
    </section>

    <!-- Section 6: Turntable Video (if available) -->
    {project.turntable && (
      <section class="mb-16" aria-labelledby="turntable-title">
        <h2 id="turntable-title" class="text-xl font-bold text-foreground mb-4">
          360° Turntable Video
        </h2>
        <VideoFacade client:idle video={project.turntable} title={`${project.title} Turntable`} />
      </section>
    )}

    <!-- Section 7: Breakdown Video (if available) -->
    {project.breakdown && (
      <section class="mb-16" aria-labelledby="breakdown-title">
        <h2 id="breakdown-title" class="text-xl font-bold text-foreground mb-4">
          Composite & Shader Breakdown Video
        </h2>
        <VideoFacade client:idle video={project.breakdown} title={`${project.title} Breakdown`} />
      </section>
    )}

    <!-- Previous / Next Navigation -->
    <nav aria-label="Project pagination" class="pt-10 border-t border-border/40 grid grid-cols-2 gap-4 text-xs font-mono-tech">
      <div>
        {prevProject && (
          <a
            href={`${basePath}/work/${prevProject.slug}`}
            class="group inline-flex flex-col text-left hover:text-primary transition-colors"
          >
            <span class="text-muted-foreground text-[11px]">← Previous Project</span>
            <span class="text-foreground group-hover:text-primary font-bold mt-1 truncate max-w-xs">
              {prevProject.title}
            </span>
          </a>
        )}
      </div>

      <div class="text-right">
        {nextProject && (
          <a
            href={`${basePath}/work/${nextProject.slug}`}
            class="group inline-flex flex-col text-right ml-auto hover:text-primary transition-colors"
          >
            <span class="text-muted-foreground text-[11px]">Next Project →</span>
            <span class="text-foreground group-hover:text-primary font-bold mt-1 truncate max-w-xs">
              {nextProject.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
