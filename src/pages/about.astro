---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const processSteps = [
  { step: "01", name: "Concept & Reference", desc: "Silhouette exploration, mood board assembly, and functional articulation analysis.", exampleSlug: projects[0]?.slug },
  { step: "02", name: "Blockout", desc: "Primary volumetric blockout to lock scale, proportions, and camera focal compositions.", exampleSlug: projects[1]?.slug },
  { step: "03", name: "Subdivision Modeling", desc: "Production-ready quad topology modeling with edge flow aligned to mechanical or anatomical deformation axes.", exampleSlug: projects[0]?.slug },
  { step: "04", name: "UV Unwrapping & Texturing", desc: "Distortion-minimized texel density UV packing followed by multi-channel PBR roughness/normal painting.", exampleSlug: projects[2]?.slug },
  { step: "05", name: "Lighting & Atmosphere", desc: "Studio 3-point setups, HDRI color grading, and volumetric depth scattering.", exampleSlug: projects[1]?.slug },
  { step: "06", name: "Render & Animation", desc: "Physically based path-traced rendering, turntable keyframing, and dynamics simulation passes.", exampleSlug: projects[3]?.slug },
  { step: "07", name: "Composite & WebGL Export", desc: "Multi-pass EXR comping or glTF Draco optimization for real-time web delivery.", exampleSlug: projects[0]?.slug },
];
---

<BaseLayout
  title={`About · ${profile.name} · 3D Artist & Technical Artist`}
  description={`Background, production pipeline, software proficiency, and technical engineering profile for Ansh Kumar Singh.`}
>
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
    <!-- Page Header -->
    <header class="mb-14 border-b border-border/40 pb-8">
      <div class="inline-flex items-center gap-2 text-xs font-mono-tech text-primary uppercase tracking-wider mb-2">
        <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        Profile & Pipeline
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight">
        About Ansh Kumar Singh
      </h1>
      <p class="text-muted-foreground font-mono-tech text-xs mt-2">
        Based in {profile.location} · {profile.education.institution}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      <!-- Left Column: Photo & Status -->
      <div class="space-y-6">
        <div class="aspect-square w-full max-w-xs overflow-hidden rounded-xl border border-border/60 bg-[hsl(var(--bg-surface))] shadow-lg">
          <img
            src="/placeholders/avatar-placeholder.svg"
            alt="Portrait photo placeholder for Ansh Kumar Singh"
            width={400}
            height={400}
            class="h-full w-full object-cover"
          />
        </div>

        <div class="space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground font-mono-tech">
            Availability Status
          </span>
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between rounded-lg border border-primary/30 bg-primary/5 p-3 text-xs">
              <span class="font-medium text-foreground">Entry-Level Roles</span>
              <span class="text-primary font-bold font-mono-tech">Active</span>
            </div>
            <div class="flex items-center justify-between rounded-lg border border-border/40 bg-white/[0.02] p-3 text-xs">
              <span class="font-medium text-foreground">Freelance Inquiries</span>
              <span class="text-muted-foreground font-mono-tech">Open</span>
            </div>
            <div class="flex items-center justify-between rounded-lg border border-border/40 bg-white/[0.02] p-3 text-xs">
              <span class="font-medium text-foreground">Collaborations</span>
              <span class="text-muted-foreground font-mono-tech">Select</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Bio & Technical Side -->
      <div class="md:col-span-2 space-y-10">
        <!-- Artist Statement / Bio -->
        <section aria-labelledby="bio-heading">
          <h2 id="bio-heading" class="text-xl font-bold text-foreground mb-4">
            Artist Statement & Focus
          </h2>
          <div class="space-y-4 text-foreground/80 leading-relaxed text-sm">
            <p>
              I am a 3D artist and technical artist focused on building high-detail hard-surface models, modular environment kits, and responsive real-time WebGL viewports. My work combines disciplined quad subdivision topology with physically based material design.
            </p>
            <p class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-4 text-xs font-mono-tech text-amber-300/90">
              <strong>Note on Artist Background (TODO_BIO):</strong> A complete personal artist statement and creative background narrative will be provided by Ansh Kumar Singh. In accordance with portfolio standards, zero synthetic client credits or fictional experience has been introduced.
            </p>
          </div>
        </section>

        <!-- Technical Side (Verified Resume Facts) -->
        <section class="rounded-xl border border-primary/30 bg-primary/[0.03] p-6" aria-labelledby="tech-side-heading">
          <div class="flex items-center gap-2 mb-3">
            <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true" />
            <h2 id="tech-side-heading" class="text-lg font-bold text-foreground font-mono-tech">
              Technical Side (Pipeline & Web Engineering)
            </h2>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed mb-4">
            In addition to 3D artistry, I bring a solid software engineering background (B.Tech in Information Technology, 2023–2027), making me well-equipped for technical-art, asset pipeline automation, and web graphics roles.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs mb-4">
            <div class="rounded-lg bg-black/40 p-3 border border-border/30">
              <span class="text-muted-foreground font-mono-tech block mb-1">Current Experience</span>
              <span class="font-bold text-foreground">{profile.internship.role}</span>
              <span class="block text-primary text-[11px] font-mono-tech">{profile.internship.company} · {profile.internship.period} ({profile.internship.type})</span>
            </div>
            <div class="rounded-lg bg-black/40 p-3 border border-border/30">
              <span class="text-muted-foreground font-mono-tech block mb-1">Formal Education</span>
              <span class="font-bold text-foreground">{profile.education.degree}</span>
              <span class="block text-muted-foreground text-[11px] font-mono-tech">{profile.education.institution} ({profile.education.period})</span>
            </div>
          </div>

          <div>
            <span class="text-[11px] uppercase tracking-wider font-mono-tech text-muted-foreground block mb-2 font-semibold">
              Verified Technical Stack
            </span>
            <div class="flex flex-wrap gap-1.5">
              {profile.technicalSkills.map((tech) => (
                <span class="rounded bg-black/50 px-2.5 py-1 text-[11px] font-mono-tech text-foreground/90 border border-border/40">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </section>

        <!-- Software Proficiency (Categorized, NO Percentage Bars) -->
        <section aria-labelledby="software-heading">
          <h2 id="software-heading" class="text-xl font-bold text-foreground mb-4">
            Software & Tool Proficiency
          </h2>
          <p class="text-xs text-muted-foreground mb-4 font-mono-tech">
            Accurate categorisation based on daily production reliance (no subjective percentage bars):
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="rounded-lg border border-border/50 bg-[hsl(var(--bg-surface))] p-4">
              <span class="text-primary font-bold font-mono-tech block mb-2 uppercase text-[11px]">
                ● Daily Production
              </span>
              <ul class="space-y-1 text-foreground/80 font-mono-tech">
                {profile.softwareProficiency.daily.map((s) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-primary">›</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="rounded-lg border border-border/50 bg-[hsl(var(--bg-surface))] p-4">
              <span class="text-muted-foreground font-bold font-mono-tech block mb-2 uppercase text-[11px]">
                ● Comfortable
              </span>
              <ul class="space-y-1 text-foreground/80 font-mono-tech">
                {profile.softwareProficiency.comfortable.map((s) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-muted-foreground">›</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="rounded-lg border border-border/50 bg-[hsl(var(--bg-surface))] p-4">
              <span class="text-amber-400 font-bold font-mono-tech block mb-2 uppercase text-[11px]">
                ● Currently Exploring
              </span>
              <ul class="space-y-1 text-foreground/80 font-mono-tech">
                {profile.softwareProficiency.learning.map((s) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-amber-400">›</span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- Hardware Specs Table -->
        <section aria-labelledby="hardware-heading">
          <h2 id="hardware-heading" class="text-xl font-bold text-foreground mb-4">
            Workstation & Hardware Specifications
          </h2>
          <div class="overflow-x-auto rounded-lg border border-border/50 bg-[hsl(var(--bg-surface))]">
            <table class="w-full text-left text-xs font-mono-tech">
              <tbody class="divide-y divide-border/30">
                {Object.entries(profile.hardwareSpecs).map(([component, spec]) => (
                  <tr class="hover:bg-white/[0.02]">
                    <td class="py-3 px-4 font-bold text-primary w-1/3">{component}</td>
                    <td class="py-3 px-4 text-foreground/80">{spec}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>

    <!-- Production Process Overview (Section 4.5) -->
    <section class="mt-16 pt-12 border-t border-border/40" aria-labelledby="process-heading">
      <div class="mb-8">
        <span class="text-xs font-mono-tech text-primary uppercase tracking-wider block mb-1">
          Methodology
        </span>
        <h2 id="process-heading" class="text-2xl sm:text-3xl font-bold text-foreground">
          Standard 3D Asset Pipeline
        </h2>
        <p class="text-xs text-muted-foreground max-w-xl mt-1">
          A predictable, milestone-driven workflow ensuring clean quad topology, non-destructive shading, and optimized real-time delivery.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {processSteps.map((step) => (
          <div class="flex flex-col justify-between rounded-lg border border-border/40 bg-[hsl(var(--bg-surface))] p-5 hover:border-primary/40 transition-colors">
            <div>
              <span class="text-xs font-bold font-mono-tech text-primary block mb-2">{step.step}</span>
              <h3 class="text-sm font-bold text-foreground mb-2">{step.name}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed mb-4">{step.desc}</p>
            </div>
            {step.exampleSlug && (
              <a
                href={`${basePath}/work/${step.exampleSlug}`}
                class="text-[11px] font-mono-tech text-primary hover:underline mt-auto"
              >
                View Example Project →
              </a>
            )}
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

