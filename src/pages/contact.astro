---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const confirmedSocials = [
  { name: "GitHub", url: profile.github, handle: "@AK050744" },
  ...(profile.linkedin && !profile.linkedin.includes("TODO")
    ? [{ name: "LinkedIn", url: profile.linkedin, handle: "Ansh Kumar Singh" }]
    : []),
  ...(profile.artstation && !profile.artstation.includes("TODO")
    ? [{ name: "ArtStation", url: profile.artstation, handle: "ArtStation Profile" }]
    : []),
  ...(profile.behance && !profile.behance.includes("TODO")
    ? [{ name: "Behance", url: profile.behance, handle: "Behance Portfolio" }]
    : []),
  ...(profile.instagram && !profile.instagram.includes("TODO")
    ? [{ name: "Instagram", url: profile.instagram, handle: "Instagram Feed" }]
    : []),
  ...(profile.discord && !profile.discord.includes("TODO")
    ? [{ name: "Discord", url: profile.discord, handle: "Community Server" }]
    : []),
];
---

<BaseLayout
  title={`Contact · Inquire for 3D & Animation Projects · ${profile.name}`}
  description={`Commission inquiries, entry-level opportunities, and technical art collaborations for Ansh Kumar Singh.`}
>
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Header -->
    <header class="mb-12 border-b border-border/40 pb-8 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 text-xs font-mono-tech text-primary uppercase tracking-wider mb-2">
        <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        Get In Touch
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight">
        Project Inquiries & Collaborations
      </h1>
      <p class="text-muted-foreground text-sm mt-3 max-w-2xl leading-relaxed">
        Currently open to entry-level 3D / Technical Artist roles, pipeline development opportunities, and select freelance 3D commissions.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-10">
      <!-- Left Column: Direct Info & Socials (2 cols) -->
      <div class="md:col-span-2 space-y-8">
        <!-- Commission Status Badge -->
        <div class="rounded-xl border border-primary/40 bg-primary/5 p-5">
          <span class="text-xs font-mono-tech text-muted-foreground uppercase block mb-1">
            Current Availability Status
          </span>
          <div class="flex items-center gap-2 text-foreground font-bold text-sm">
            <span class="h-2.5 w-2.5 rounded-full bg-primary animate-pulse" aria-hidden="true" />
            <span>Open for Opportunities</span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
            Fast turnaround on inquiries. Response guaranteed within 24–48 hours.
          </p>
        </div>

        <!-- Direct Email -->
        <div class="space-y-2">
          <span class="text-xs font-mono-tech text-muted-foreground uppercase block">
            Direct Inquiries
          </span>
          <a
            href={`mailto:${profile.email}`}
            class="text-base font-bold text-primary hover:underline break-all"
          >
            {profile.email}
          </a>
          <span class="text-xs text-muted-foreground block font-mono-tech">
            Pune, Maharashtra, India (IST / UTC+5:30)
          </span>
        </div>

        <!-- Verified Connect Channels -->
        <div class="space-y-3">
          <span class="text-xs font-mono-tech text-muted-foreground uppercase block font-semibold">
            Verified Profiles
          </span>
          <div class="space-y-2">
            {confirmedSocials.map((soc) => (
              <a
                href={soc.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between rounded-lg border border-border/40 bg-[hsl(var(--bg-surface))] p-3 text-xs hover:border-primary/50 transition-colors"
              >
                <span class="font-medium text-foreground">{soc.name}</span>
                <span class="text-muted-foreground font-mono-tech">{soc.handle} ↗</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Optional Rate Sheet PDF (behind feature flag) -->
        {profile.features.rateSheet && (
          <div class="pt-4 border-t border-border/30">
            <a
              href="/downloads/rate-sheet.pdf"
              download
              class="inline-flex items-center gap-2 text-xs font-mono-tech text-primary hover:underline"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download 3D Services & Rate Sheet (PDF)</span>
            </a>
          </div>
        )}
      </div>

      <!-- Right Column: Accessible Contact Form (3 cols) -->
      <div class="md:col-span-3">
        <form
          id="contact-form"
          action="https://formspree.io/f/placeholder"
          method="POST"
          class="space-y-5 rounded-xl border border-border/50 bg-[hsl(var(--bg-surface))] p-6 sm:p-8 shadow-xl"
        >
          <!-- Honeypot Spam Protection (Hidden from sighted users and screen readers) -->
          <div class="hidden" aria-hidden="true">
            <label for="company-url-hp">Leave this field blank</label>
            <input type="text" id="company-url-hp" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Name field -->
          <div>
            <label for="sender-name" class="block text-xs font-mono-tech text-foreground font-semibold mb-1.5">
              Your Name or Studio <span class="text-primary">*</span>
            </label>
            <input
              type="text"
              id="sender-name"
              name="name"
              required
              placeholder="e.g. Maya Patel / Vertex Studios"
              class="w-full rounded-md border border-border/60 bg-[hsl(var(--bg-studio))] px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring"
            />
          </div>

          <!-- Email field -->
          <div>
            <label for="sender-email" class="block text-xs font-mono-tech text-foreground font-semibold mb-1.5">
              Your Email Address <span class="text-primary">*</span>
            </label>
            <input
              type="email"
              id="sender-email"
              name="email"
              required
              placeholder="name@company.com"
              class="w-full rounded-md border border-border/60 bg-[hsl(var(--bg-studio))] px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring"
            />
          </div>

          <!-- Project Category -->
          <div>
            <label for="project-category" class="block text-xs font-mono-tech text-foreground font-semibold mb-1.5">
              Inquiry Type / Scope
            </label>
            <select
              id="project-category"
              name="category"
              class="w-full rounded-md border border-border/60 bg-[hsl(var(--bg-studio))] px-3.5 py-2.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            >
              <option value="entry-level">Full-Time / Entry-Level Role</option>
              <option value="hard-surface">Hard-Surface 3D Modeling</option>
              <option value="environment">Environment Art / Modular Kit</option>
              <option value="product">Product Visualization</option>
              <option value="webgl">WebGL / Three.js Pipeline</option>
              <option value="other">Other Collaboration</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="sender-message" class="block text-xs font-mono-tech text-foreground font-semibold mb-1.5">
              Project Brief or Message <span class="text-primary">*</span>
            </label>
            <textarea
              id="sender-message"
              name="message"
              rows="5"
              required
              placeholder="Describe your timeline, polygon/texture requirements, or project details..."
              class="w-full rounded-md border border-border/60 bg-[hsl(var(--bg-studio))] px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full rounded-lg bg-primary py-3 px-4 text-sm font-semibold text-primary-foreground shadow-lg transition-colors hover:bg-amber-400 focus-visible:ring-2 focus-visible:ring-ring"
          >
            Send Inquiry
          </button>

          <!-- Form Status Live Region (WCAG 4.1.3) -->
          <div id="form-status" class="text-xs font-mono-tech text-center mt-2" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusDiv = document.getElementById("form-status");

  if (form && statusDiv) {
    form.addEventListener("submit", (e) => {
      // Validate honeypot field
      const hp = (document.getElementById("company-url-hp") as HTMLInputElement)?.value;
      if (hp) {
        e.preventDefault();
        statusDiv.textContent = "Submission rejected.";
        return;
      }

      // If formspree endpoint is default placeholder, prevent external submission error and show confirmation
      if (form.action.includes("placeholder")) {
        e.preventDefault();
        statusDiv.className = "text-xs font-mono-tech text-center mt-2 text-primary";
        statusDiv.textContent = "Thank you! Inquiry recorded successfully in development mode.";
        form.reset();
      }
    });
  }
</script>

